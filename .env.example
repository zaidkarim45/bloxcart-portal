# Copy to .env.local and fill in real values. Nothing in this file is a
# real secret. Every integration this app makes has a documented dev-mode
# fallback (see docs/ARCHITECTURE.md) so the app runs without any of these
# being set.

# --- Brand (public, safe to expose to the client) ---
NEXT_PUBLIC_BRAND_NAME="Bloxcart"
NEXT_PUBLIC_BRAND_SHORT_NAME="Bloxcart"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
NEXT_PUBLIC_STORE_URL="https://example.com"
NEXT_PUBLIC_SUPPORT_URL="https://example.com/contact"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_, never send to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Shopify ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
# Used to verify webhook HMAC signatures -- see lib/shopify/webhooks.ts.
SHOPIFY_WEBHOOK_SECRET=

# --- Discord (internal staff notifications) ---
DISCORD_WEBHOOK_URL=

# --- Roblox ---
# Only public profile/avatar endpoints are used -- no auth token needed.
# This exists in case Roblox ever rate-limits unauthenticated requests
# and a future integration needs a way to identify calls.
ROBLOX_API_USER_AGENT="bloxcart-portal/1.0"

# --- App ---
# Toggles demo/mock mode explicitly rather than inferring it from missing
# credentials -- see lib/config.ts.
NEXT_PUBLIC_DEMO_MODE=true
